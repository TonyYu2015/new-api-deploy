# Real environment files and local secret overrides (the committed base
# configs are .env.dev, .env.staging, and .env.production).
.env
.env.development
.env.*.local
data/
*.log
__pycache__/
*.py[cod]
.local-run/
ui-tests/node_modules/
ui-tests/test-results/
ui-tests/playwright-report/
ui-tests/.auth/
ui-tests/.env.e2e

# Deployment-host artefacts: database dumps and pre-change copies of env files
# or compose files. They stay on the server and must never be committed.
backups/
*.before-*
