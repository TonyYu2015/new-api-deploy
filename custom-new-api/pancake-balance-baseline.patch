+const PANCAKE_QUOTA_BASELINE_STORAGE_KEY =
+  'waffo_pancake_quota_before_payment'
+
+function clearPancakeQuotaBaseline() {
+  try {
+    sessionStorage.removeItem(PANCAKE_QUOTA_BASELINE_STORAGE_KEY)
+  } catch {
+    // Storage can be unavailable in restricted browser contexts.
+  }
+}
+
+function readPancakeQuotaBaseline(): number | null {
+  try {
+    const storedQuota = sessionStorage.getItem(
+      PANCAKE_QUOTA_BASELINE_STORAGE_KEY
+    )
+    if (storedQuota === null) return null
+
+    const quota = Number(storedQuota)
+    return Number.isSafeInteger(quota) && quota >= 0 ? quota : null
+  } catch {
+    return null
+  }
+}
+
+function storePancakeQuotaBaseline(quota: number | undefined) {
+  clearPancakeQuotaBaseline()
+  if (!Number.isSafeInteger(quota) || (quota ?? -1) < 0) return
+
+  try {
+    sessionStorage.setItem(
+      PANCAKE_QUOTA_BASELINE_STORAGE_KEY,
+      String(quota)
+    )
+  } catch {
+    // The return page still refreshes once when storage is unavailable.
+  }
+}
