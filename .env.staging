# Staging environment (test.ccaiservice.com).
# Secrets live in the gitignored .env.staging.local override.
COMPOSE_PROJECT_NAME=new-api-staging

NEW_API_IMAGE=ccai/new-api:rc15-ccai.8
MYSQL_IMAGE=mysql:8.4
REDIS_IMAGE=redis:7-alpine
CADDY_IMAGE=caddy:2.8-alpine
NGINX_IMAGE=nginx:1.27-alpine

APP_CONTAINER_NAME=new-api-staging
CADDY_CONTAINER_NAME=new-api-staging-nginx
HTML_FILTER_CONTAINER_NAME=new-api-staging-html-filter
MYSQL_CONTAINER_NAME=new-api-staging-mysql
REDIS_CONTAINER_NAME=new-api-staging-redis

HTTP_PORT=3002
HTTPS_PORT=3444
MYSQL_PORT=3308
CADDYFILE_PATH=./caddy/Caddyfile.staging
NGINX_CONF_DIR=./nginx/staging-conf.d
NGINX_ASSETS_DIR=./nginx/staging-assets
TZ=Asia/Shanghai

NEW_API_DATA_DIR=./data/staging/new-api
MYSQL_DATA_DIR=./data/staging/mysql
REDIS_DATA_DIR=./data/staging/redis

MYSQL_DATABASE=new_api_staging
MYSQL_USER=new_api
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
REDIS_PASSWORD=
SESSION_SECRET=
CRYPTO_SECRET=

# Gateway safeguards.
GLOBAL_API_RATE_LIMIT_ENABLE=true
GLOBAL_API_RATE_LIMIT=120
GLOBAL_API_RATE_LIMIT_DURATION=60
GLOBAL_WEB_RATE_LIMIT_ENABLE=true
GLOBAL_WEB_RATE_LIMIT=60
GLOBAL_WEB_RATE_LIMIT_DURATION=60
CRITICAL_RATE_LIMIT_ENABLE=true
CRITICAL_RATE_LIMIT=10
CRITICAL_RATE_LIMIT_DURATION=600
RELAY_TIMEOUT=0
STREAMING_TIMEOUT=600
MAX_REQUEST_BODY_MB=32
ERROR_LOG_ENABLED=true
CHANNEL_UPDATE_FREQUENCY=60
CHANNEL_TEST_FREQUENCY=60
