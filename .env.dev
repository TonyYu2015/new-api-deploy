# Local development environment.
# Secrets live in the gitignored .env.dev.local override; keep this file clean.
COMPOSE_PROJECT_NAME=new-api-dev
NEW_API_IMAGE=calciumion/new-api:latest
MYSQL_IMAGE=mysql:8.4
REDIS_IMAGE=redis:7-alpine
CADDY_IMAGE=caddy:2.8-alpine
NGINX_IMAGE=nginx:1.27-alpine
CADDYFILE_PATH=./caddy/Caddyfile.local
NGINX_CONF_DIR=./nginx/conf.d
NGINX_ASSETS_DIR=./nginx/assets

HTTP_PORT=3101
HTTPS_PORT=3444
MYSQL_PORT=3308
TZ=Asia/Shanghai

APP_CONTAINER_NAME=new-api-dev
CADDY_CONTAINER_NAME=new-api-dev-caddy
HTML_FILTER_CONTAINER_NAME=new-api-dev-html-filter
MYSQL_CONTAINER_NAME=new-api-dev-mysql
REDIS_CONTAINER_NAME=new-api-dev-redis

NEW_API_DATA_DIR=./data/development/new-api
MYSQL_DATA_DIR=./data/development/mysql
REDIS_DATA_DIR=./data/development/redis

SESSION_SECRET=
CRYPTO_SECRET=

MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=new_api
MYSQL_USER=new_api
MYSQL_PASSWORD=

REDIS_PASSWORD=

# Gateway safeguards.
GLOBAL_API_RATE_LIMIT_ENABLE=true
GLOBAL_API_RATE_LIMIT=120
GLOBAL_API_RATE_LIMIT_DURATION=60
GLOBAL_WEB_RATE_LIMIT_ENABLE=true
GLOBAL_WEB_RATE_LIMIT=60
GLOBAL_WEB_RATE_LIMIT_DURATION=60
CRITICAL_RATE_LIMIT_ENABLE=true
CRITICAL_RATE_LIMIT=10
CRITICAL_RATE_LIMIT_DURATION=600
RELAY_TIMEOUT=0
STREAMING_TIMEOUT=600
MAX_REQUEST_BODY_MB=32
ERROR_LOG_ENABLED=true
CHANNEL_UPDATE_FREQUENCY=60
CHANNEL_TEST_FREQUENCY=60

# Native New API Creem top-up settings for local testing.
CREEM_TEST_MODE=true
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
CREEM_PRODUCT_ID=
CREEM_PRODUCT_NAME=Test $5
CREEM_PRODUCT_PRICE=5
CREEM_PRODUCT_CURRENCY=USD
CREEM_QUOTA_PER_USD=500000
CREEM_TEST_USER_EMAIL=admin@example.com

# OpenAI-compatible upstream channel.
UPSTREAM_CHANNEL_NAME=
UPSTREAM_MODEL_NAMES=
UPSTREAM_BASE_URL=
UPSTREAM_API_KEY=
