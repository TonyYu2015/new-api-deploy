# Oracle production environment.
# Secrets live in the gitignored .env.production.local override.
COMPOSE_PROJECT_NAME=new-api-deploy

# Built from custom-new-api/Dockerfile. Record the verified image ID in
# config/production-rollout.md before deployment.
NEW_API_IMAGE=ccai/new-api:rc15-ccai.4
MYSQL_IMAGE=mysql:8.4
REDIS_IMAGE=redis:7-alpine
CADDY_IMAGE=caddy:2.8-alpine
NGINX_IMAGE=nginx:1.27-alpine

APP_CONTAINER_NAME=new-api
CADDY_CONTAINER_NAME=new-api-nginx
HTML_FILTER_CONTAINER_NAME=new-api-html-filter
MYSQL_CONTAINER_NAME=new-api-mysql
REDIS_CONTAINER_NAME=new-api-redis

HTTP_PORT=80
HTTPS_PORT=443
MYSQL_PORT=3307
CADDYFILE_PATH=./caddy/Caddyfile
NGINX_CONF_DIR=./nginx/conf.d
NGINX_ASSETS_DIR=./nginx/assets
TZ=Asia/Shanghai

# Keep production data paths compatible with the existing Oracle install.
NEW_API_DATA_DIR=./data/new-api
MYSQL_DATA_DIR=./data/mysql
REDIS_DATA_DIR=./data/redis

MYSQL_DATABASE=new_api
MYSQL_USER=new_api
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
REDIS_PASSWORD=
SESSION_SECRET=
CRYPTO_SECRET=

# Gateway safeguards.
GLOBAL_API_RATE_LIMIT_ENABLE=true
GLOBAL_API_RATE_LIMIT=120
GLOBAL_API_RATE_LIMIT_DURATION=60
GLOBAL_WEB_RATE_LIMIT_ENABLE=true
GLOBAL_WEB_RATE_LIMIT=60
GLOBAL_WEB_RATE_LIMIT_DURATION=60
CRITICAL_RATE_LIMIT_ENABLE=true
CRITICAL_RATE_LIMIT=10
CRITICAL_RATE_LIMIT_DURATION=600
RELAY_TIMEOUT=0
STREAMING_TIMEOUT=600
MAX_REQUEST_BODY_MB=32
ERROR_LOG_ENABLED=true
CHANNEL_UPDATE_FREQUENCY=60
CHANNEL_TEST_FREQUENCY=60

# OpenAI-compatible upstream channel.
UPSTREAM_CHANNEL_NAME=
UPSTREAM_MODEL_NAMES=
UPSTREAM_BASE_URL=
UPSTREAM_API_KEY=
